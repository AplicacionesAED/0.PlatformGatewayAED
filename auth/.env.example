NODE_ENV=development
PORT=3060

# Postgres: un solo enlace (produccion, base interna de Coolify). Para dev usa una base propia terminada en _dev;
# las pruebas (npm test) exigen una base terminada en _test y se niegan a correr contra otra.
DATABASE_URL=postgres://usuario:clave@localhost:5432/portal_aed_dev
PGSSL=
# Solo para `npm test`: base de pruebas (el nombre debe terminar en _test).
DATABASE_URL_TEST=

CORS_ORIGIN=http://localhost:5190
FRONTEND_URL=http://localhost:5190

# Llave privada RSA (PEM en base64, una sola linea) con la que se firman las sesiones. Las apps verifican con la
# publica (GET /api/.well-known/jwks.json). En produccion es obligatoria; en dev, sin ella se genera una efimera.
PORTAL_JWT_PRIVATE_KEY_B64=
PORTAL_JWT_KID=k1

# Ruta (vista por el navegador) de la cookie de renovacion. Detras del gateway: /portal/api/auth. Local: /api/auth.
PORTAL_REFRESH_COOKIE_PATH=/api/auth

# Correos con acceso de administrador: al entrar con Microsoft quedan como es_admin (y se crean si no existen).
PORTAL_ADMIN_EMAILS=
# Dominios corporativos (separados por coma): sus cuentas entran SOLO con Microsoft, sin contrasena.
PORTAL_CORPORATE_DOMAINS=aed.com.co

# SSO de Azure AD (registro "Acceso Apps"). AZURE_REDIRECT_URI debe estar registrado como URI de tipo "Web".
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:3060/api/auth/azure/callback
